 api/inquiry.js           |  4 ++++
 src/app.jsx              | 11 +++++++++
 src/camps.jsx            | 38 ++++++++++++++++++++++++++++++-
 src/private.jsx          | 11 ++++-----
 10 files changed, 132 insertions(+), 6 deletions(-)
 create mode 100644 api/_platform.js
 create mode 100644 api/catalog.js

