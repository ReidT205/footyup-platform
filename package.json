{
  "name": "footyup-registration-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev-server.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "camps:upsert": "tsx --env-file-if-exists=.env scripts/camps.ts",
    "miami": "tsx --env-file-if-exists=.env scripts/miami.ts",
    "settings": "tsx --env-file-if-exists=.env scripts/settings.ts",
    "waiver": "tsx --env-file-if-exists=.env scripts/waiver.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/setup-db.ts && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "licenses:check": "tsx scripts/check-licenses.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
